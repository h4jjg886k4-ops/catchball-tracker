rules_version = '2';

// CatchCoach Firestore rules.
// NOTE: deploying this file REPLACES the rules currently set in the Firebase
// console. The first block reproduces owner-only access to users/{uid}/**;
// compare with the console before deploying.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each coach has full access to their own data, and nobody else's.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read of ONE completed match while its coach has sharing on.
    // get only (no list), so match ids can't be enumerated.
    match /users/{userId}/matches/{matchId} {
      allow get: if resource.data.shareEnabled == true;
    }

    // Share-link lookup: token -> { userId, matchId, createdAt }.
    // Anyone holding a token may read that one document; only the owning
    // coach may create, update or delete it.
    match /sharedMatches/{token} {
      allow get: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['userId', 'matchId', 'createdAt']);
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
